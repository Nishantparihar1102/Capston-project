# Google Gemini API Key (for LLM reasoning & response generation)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gnani.ai API Key (for STT transcription and TTS audio synthesis)
# Mandatory for Step 4. Get your key from: https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here

# Optional: Path to Capstone Dataset root folder (defaults to auto-detection)
# CAPSTONE_DATASET_DIR=../Capstone_Project_Dataset_FTTT_2026/Capstone_Project_Dataset_FTTT_2026
